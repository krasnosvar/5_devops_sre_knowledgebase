# helmfile.yaml.gotmpl — управление несколькими Helm-релизами одним файлом
# Установка helmfile: https://helmfile.readthedocs.io/
# В helmfile v1 файл рендерится как Go-шаблон только с расширением
# .gotmpl, а environments и releases должны быть в разных YAML-частях
# (разделитель ---).
# Проверка без кластера:
#   PG_PASSWORD=x GRAFANA_PASSWORD=x helmfile -f helmfile.yaml.gotmpl -e dev build

repositories:
  - name: bitnami
    url: https://charts.bitnami.com/bitnami
  - name: prometheus-community
    url: https://prometheus-community.github.io/helm-charts

environments:
  dev:
    values:
      - replicas: 1
        resources: {requests: {cpu: 50m, memory: 64Mi}}
  production:
    values:
      - replicas: 3
        resources: {requests: {cpu: 500m, memory: 512Mi}}

---
releases:
  # Внимание: с 2025 года бесплатный каталог Bitnami сильно урезан —
  # версионированные образы перенесены в архивный `bitnamilegacy` без
  # обновлений, актуальные распространяются по платной подписке. Релиз
  # оставлен как иллюстрация синтаксиса helmfile (requiredEnv, условия по
  # окружению, needs). В реальном проекте для PostgreSQL — оператор
  # CloudNativePG (чарт cnpg/cloudnative-pg) или официальный образ postgres
  # в собственном чарте.
  - name: postgres
    namespace: database
    chart: bitnami/postgresql
    version: "14.3.3"
    values:
      - auth:
          postgresPassword: {{ requiredEnv "PG_PASSWORD" | quote }}
        primary:
          persistence:
            size: {{ if eq .Environment.Name "production" }}50Gi{{ else }}1Gi{{ end }}

  - name: monitoring
    namespace: monitoring
    chart: prometheus-community/kube-prometheus-stack
    version: "55.5.0"
    values:
      - grafana:
          adminPassword: {{ requiredEnv "GRAFANA_PASSWORD" | quote }}
        prometheus:
          prometheusSpec:
            retention: 30d

  - name: myapp
    namespace: production
    chart: ./myapp                # локальный chart из 02_examples/myapp/
    values:
      - replicaCount: {{ .Values.replicas }}
        resources:
          {{- .Values.resources | toYaml | nindent 10 }}
    needs:
      - database/postgres         # деплоить после postgres
