# .env.example — шаблон, коммитить в git
# Скопировать в .env и заполнить реальными значениями
# .env добавить в .gitignore!

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mydb
DB_USER=myuser
DB_PASSWORD=                    # заполнить!

# External APIs
STRIPE_PUBLIC_KEY=pk_test_...   # безопасно хранить (public)
STRIPE_SECRET_KEY=              # заполнить! НИКОГДА не коммитить

# AWS (использовать IAM Role/IRSA вместо статических ключей)
# AWS_ACCESS_KEY_ID=            # не хранить в .env, использовать IAM Role
# AWS_SECRET_ACCESS_KEY=        # не хранить в .env

# Vault (для local dev)
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=dev-root-token      # только для local dev, не prod!

# App settings
LOG_LEVEL=info
DEBUG=false
